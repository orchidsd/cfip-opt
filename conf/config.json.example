{
  "mode": "domain",
  "ip_version": "ipv4",
  "port": 443,
  "speed_test": {
    "enabled": true,
    "url": "https://nodejs.org/dist/v20.11.0/node-v20.11.0.tar.gz",
    "threads": 200,
    "display_count": 10,
    "test_times": 4,
    "download_timeout": 15,
    "display_results": 10,
    "avg_latency_max": 9999,
    "avg_latency_min": 0,
    "download_speed_min": 0,
    "packet_loss_max": 1.00,
    "httping": false,
    "httping_code": 200,
    "debug": false,
    "allip": false,
    "colo": "TPE,HKG,NRT,HND,KIX,SIN,LAX,SJC,SEA,OKA,ICN,FRA"
  },
  "verify": {
    "enabled": true,
    "max_ms": 1200,
    "probes": 3
  },
  "watchdog": {
    "enabled": false,
    "auto_run": true,
    "fail_consecutive": 3
  },
  "ip_list": {
    "auto_update": true,
    "max_age_days": 7
  },
  "cloudflare": {
    "email": "",
    "zone_id": "",
    "api_key": "",
    "domain": "",
    "subdomain": "",
    "strategy": "multi_to_one",
    "hostname": "",
    "min_records": 6,
    "keep_days": 2,
    "max_records": 24,
    "node_domains": ""
  },
  "proxy_client": "openclash",
  "restart_wait_sec": 30,
  "notifications": {
    "telegram": {
      "enabled": false,
      "bot_token": "",
      "user_id": "",
      "api_host": "api.telegram.org"
    },
    "pushplus": {
      "enabled": false,
      "token": ""
    }
  }
}